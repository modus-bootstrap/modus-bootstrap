---
import { getConfig } from '@libs/config'
import { getDocsPath } from '@libs/path'
import Code from '@shortcodes/Code.astro'
---

<div class="lg:col-7 mx-auto pb-3 mb-3 md:mb-5 md:text-center">
  <div class="masthead-followup-icon d-inline-block mb-3" style="--bg-rgb: var(--bd-violet-rgb);">
    <svg class="bi fs-1" aria-hidden="true"><use href="#code"></use></svg>
  </div>
  <h2 class="display-5 mb-3 fw-semibold lh-sm">Get started any way you&nbsp;want</h2>
  <p class="lead fw-normal">
    Jump right into building with Modus Bootstrap—use the CDN, install it via package manager, or download the source
    code.
  </p>
  <p class="d-flex md:justify-content-center lead fw-normal">
    <a href={getDocsPath('getting-started/install/')} class="icon-link icon-link-hover fw-semibold md:ps-4">
      Read installation docs
      <svg class="bi" aria-hidden="true"><use href="#arrow-right"></use></svg>
    </a>
  </p>
</div>

<section class="row g-3 md:g-5 mb-5 pb-5 justify-content-center">
  <div class="lg:col-6 lg:py-4 lg:pe-5">
    <svg class="bi mb-2 fs-2 fg-3" aria-hidden="true"><use href="#box-seam"></use></svg>
    <h3 class="fw-semibold">Install via package manager</h3>
    <p class="lg:pe-5">
      Install Modus Bootstrap’s source Sass and JavaScript files via npm, Composer, or Meteor. Package-managed
      installs don’t include documentation or our full build scripts. You can also <a
        href="https://github.com/twbs/examples/">use any demo from our Examples repo</a
      > to quickly jumpstart Modus Bootstrap projects.
    </p>
    <Code code={`npm install modus-bootstrap@${getConfig().current_version}`} lang="sh" />
    <p>
      <a href={getDocsPath('getting-started/install')}>Read our installation docs</a> for more info and additional package
      managers.
    </p>
  </div>
  <div class="lg:col-6 lg:py-4 lg:ps-5 border-lg-start">
    <svg class="bi mb-2 fs-2 fg-3" aria-hidden="true"><use href="#globe2"></use></svg>
    <h3 class="fw-semibold">Include via CDN</h3>
    <p class="lg:pe-5">
      When you only need to include Modus Bootstrap’s compiled CSS or Bootstrap’s JS, you can use <a
        href="https://www.jsdelivr.com/package/npm/bootstrap">jsDelivr</a
      >. See it in action with our simple <a href={getDocsPath('guides/quickstart/')}>quick start</a>, or <a
        href={getDocsPath('examples')}>browse the examples</a
      > to jumpstart your next project.
    </p>
    <Code code={`<link href="${getConfig().cdn.css}" rel="stylesheet">`} lang="html" />
    <Code
      code={`<script type="module" src="${getConfig().cdn.js_bundle}" integrity="${
        getConfig().cdn.js_bundle_hash
      }" crossorigin="anonymous"></script>`}
      lang="html"
    />
  </div>

  <div class="md:col-8 mx-auto text-center">
    <h4 class="fw-semibold">Read our getting started guides</h4>
    <p>Get a jump on including Modus Bootstrap's source files in a new project with our official guides.</p>
    <div class="d-flex flex-wrap align-items-center justify-content-center gap-4 mt-4">
      <a
        class="d-flex flex-column align-items-center text-decoration-none animate-img"
        href={getDocsPath('guides/npm/')}
      >
        <img
          class="d-block mb-2"
          src={getDocsPath('/assets/img/npm.svg')}
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
        <span class="fg-3">npm</span>
      </a>
      <a
        class="d-flex flex-column align-items-center text-decoration-none animate-img"
        href={getDocsPath('guides/webpack/')}
      >
        <img
          class="d-block mb-2"
          src={getDocsPath('/assets/img/webpack.svg')}
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
        <span class="fg-3">Webpack</span>
      </a>
      <a
        class="d-flex flex-column align-items-center text-decoration-none animate-img"
        href={getDocsPath('guides/parcel/')}
      >
        <img
          class="d-block mb-2"
          src={getDocsPath('/assets/img/parcel.png')}
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
        <span class="fg-3">Parcel</span>
      </a>
      <a
        class="d-flex flex-column align-items-center text-decoration-none animate-img"
        href={getDocsPath('guides/vite/')}
      >
        <img
          class="d-block mb-2"
          src={getDocsPath('/assets/img/vite.svg')}
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
        <span class="fg-3">Vite</span>
      </a>
    </div>
  </div>
</section>
