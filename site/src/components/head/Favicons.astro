---
import { getDocsPath, getVersionedDocsPath } from '@libs/path'
---

<link rel="icon" href={getVersionedDocsPath('/favicon.ico')} sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href={getDocsPath('/assets/img/favicons/favicon-32x32.png')} sizes="32x32" type="image/png" />
<link rel="icon" href={getDocsPath('/assets/img/favicons/favicon-16x16.png')} sizes="16x16" type="image/png" />
<link rel="manifest" href={getDocsPath('/assets/img/favicons/manifest.json')} />
<meta name="theme-color" content="#712cf9" />
