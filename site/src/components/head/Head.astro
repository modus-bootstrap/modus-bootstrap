---
import { getConfig } from '@libs/config'
import { getDocsPath, getVersionedDocsPath } from '@libs/path'
import type { Layout } from '@libs/layout'
import { getLastModified } from '@libs/last-modified'
import Stylesheet from '@components/head/Stylesheet.astro'

interface Props {
  description: string
  lastModified?: string
  layout: Layout
  robots: string | undefined
  thumbnail: string
  title: string
}

const { description, lastModified, layout, robots, thumbnail, title } = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const speculationRules = JSON.stringify(
  {
    prerender: [
      {
        where: {
          href_matches: '/*'
        },
        eagerness: 'moderate'
      }
    ]
  },
  null,
  2
)

const isHome = Astro.url.pathname === '/'
const pageTitle = isHome
  ? `${getConfig().title} · ${getConfig().subtitle}`
  : `${title} · ${getConfig().title} v${getConfig().docs_version}`

// Dynamic imports to avoid build-time processing
const Scss = import.meta.env.PROD ? undefined : await import('@components/head/Scss.astro')
const ScssProd = import.meta.env.PROD ? await import('@components/head/ScssProd.astro') : undefined
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" href={getVersionedDocsPath('/favicon.ico')} sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<link rel="license" href={`${getConfig().repo}/blob/main/LICENSE`} />
<link rel="author" href={`${getConfig().repo}/graphs/contributors`} />
<meta name="color-scheme" content="light dark" />
<meta name="last-modified" content={lastModified ?? getLastModified()} />

<title>{pageTitle}</title>

<meta name="robots" content={robots ?? 'noindex'} />

{getConfig().site_verification.google && <meta name="google-site-verification" content={getConfig().site_verification.google} />}
{getConfig().site_verification.bing && <meta name="msvalidate.01" content={getConfig().site_verification.bing} />}

{/* Loaded as `is:inline` (not via Vite) so the theme is applied before paint. */}
{/* The script lives in `site/static/assets/js/` so it can */}
{/* render-block at this exact spot in the head without going through the */}
{/* bundler (which would defer it and cause a flash of the wrong theme). */}
{/* The `.min.js` copy is generated by `minifyStaticScripts()` in `src/libs/astro.ts`. */}
<script is:inline src={getDocsPath('assets/js/color-modes.min.js')}></script>

<script is:inline type="speculationrules" set:html={speculationRules} />

{
  import.meta.env.PROD && ScssProd && (
    <>
      <Stylesheet />
      <ScssProd.default />
    </>
  )
}

{!import.meta.env.PROD && Scss && <Scss.default />}
