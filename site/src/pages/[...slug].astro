---
import type { InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import DocsLayout from '@layouts/DocsLayout.astro'
import * as shortcodes from '@components/shortcodes'
import { docsPages, getDocsPageSlug } from '@libs/content'
import { getLastModified } from '@libs/last-modified'

export async function getStaticPaths() {
  return docsPages.map((docsPage) => {
    return {
      params: { slug: getDocsPageSlug(docsPage.id) },
      props: docsPage
    }
  })
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { id, data, filePath } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(Astro.props)
---

<DocsLayout
  frontmatter={remarkPluginFrontmatter as typeof data}
  headings={headings}
  id={id}
  lastModified={getLastModified(filePath)}
>
  <Content components={{ ...shortcodes, pre: shortcodes.Code }} />
</DocsLayout>
