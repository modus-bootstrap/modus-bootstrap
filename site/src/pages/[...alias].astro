---
import type { AstroInstance, InferGetStaticPropsType } from 'astro'
import RedirectLayout from '@layouts/RedirectLayout.astro'
import { getConfig } from '@libs/config'
import { getDocsPath } from '@libs/path'
import { trimLeadingAndTrailingSlashes } from '@libs/utils'
import { replaceConfigInText } from '@libs/remark'
import { aliasedDocsPages, docsPages, getDocsPageSlug } from '@libs/content'
import { getAliasedExamplesPages, getExampleNameFromPagePath } from '@libs/examples'

export async function getStaticPaths() {
  function normalizeAliases(aliases: string | string[] | undefined): string[] {
    return aliases ? (Array.isArray(aliases) ? aliases : [aliases]) : []
  }

  function getAliasStaticPath(alias: string, path: string) {
    return { params: { alias: trimLeadingAndTrailingSlashes(replaceConfigInText(alias)) }, props: { path } }
  }

  const staticPaths = []

  // The docs used to live under `/docs/${docs_version}/`. Each old URL redirects to its new URL.
  const legacyPrefix = `docs/${getConfig().docs_version}`

  function getLegacyStaticPath(alias: string, path: string) {
    return getAliasStaticPath(`${legacyPrefix}/${trimLeadingAndTrailingSlashes(alias)}`, path)
  }

  staticPaths.push(getAliasStaticPath(legacyPrefix, '/getting-started/install/'))
  staticPaths.push(getLegacyStaticPath('examples', '/examples/'))

  for (const docsPage of docsPages) {
    const slug = getDocsPageSlug(docsPage.id)

    staticPaths.push(getLegacyStaticPath(slug, `/${slug}/`))
  }

  const examplesPageModules = import.meta.glob('../assets/examples/**/*.astro', { eager: true })
  const examplesPages = Object.values(examplesPageModules) as AstroInstance[]
  const aliasedExamplesPages = getAliasedExamplesPages(examplesPages)

  for (const examplesPage of examplesPages) {
    const path = `/examples/${getExampleNameFromPagePath(examplesPage.file)}/`

    staticPaths.push(getLegacyStaticPath(path, path))
  }

  // Generate static paths for all examples pages with aliases.
  for (const aliasedExamplesPage of aliasedExamplesPages) {
    const aliases = normalizeAliases(aliasedExamplesPage.aliases)

    for (const alias of aliases) {
      const path = `/examples/${getExampleNameFromPagePath(aliasedExamplesPage.file)}/`

      staticPaths.push(getAliasStaticPath(alias, path), getLegacyStaticPath(replaceConfigInText(alias), path))
    }
  }

  // Generate static paths for all docs pages with aliases.
  for (const aliasedDocsPage of aliasedDocsPages) {
    const aliases = normalizeAliases(aliasedDocsPage.data.aliases)

    for (const alias of aliases) {
      const path = `/${getDocsPageSlug(aliasedDocsPage.id)}/`

      staticPaths.push(getAliasStaticPath(alias, path), getLegacyStaticPath(replaceConfigInText(alias), path))
    }
  }

  // Keep the first redirect for each alias. Some pages share an alias, e.g. `/components/`.
  const seenAliases = new Set<string>()

  return staticPaths.filter(({ params }) => !seenAliases.has(params.alias) && seenAliases.add(params.alias))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { path } = Astro.props
---

<RedirectLayout path={getDocsPath(path)} />
