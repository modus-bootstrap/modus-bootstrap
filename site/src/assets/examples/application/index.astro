---
export const title = 'Application example'
export const extra_css = [
  'https://cdn.jsdelivr.net/npm/@trimble-oss/modus-icons@1.21.0/dist/transportation/css/transportation-icons.css',
  'https://cdn.jsdelivr.net/npm/@trimble-oss/modus-icons-css@0.11.0/css/modus-icons-duotone.min.css',
  'application.css',
]
export const extra_js = [{ src: 'application.js' }]
export const body_class = 'app-with-sidebar'
---

  <aside class="app-sidebar bg-body d-flex flex-column bg-opacity-90 position-fixed align-items-center" aria-label="Primary navigation">
    <nav class="nav">
      <a href="#" class="nav-link active" aria-current="page" aria-label="Routing">
        <i class="transportation-icon-map" aria-hidden="true"></i>
      </a>
      <a href="#" class="nav-link" aria-label="Application Settings">
        <i class="transportation-icon-route" aria-hidden="true"></i>
      </a>
      <a href="#" class="nav-link" aria-label="Account Settings">
        <i class="transportation-icon-trip-list" aria-hidden="true"></i>
      </a>
      <a href="#" class="nav-link" aria-label="Vehicle Routing Profiles">
        <i class="transportation-icon-location" aria-hidden="true"></i>
      </a>
      <a href="#" class="nav-link" aria-label="QuickBatch">
        <i class="transportation-icon-settings" aria-hidden="true"></i>
      </a>
    </nav>
  </aside>

  <header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm fixed-top" aria-label="Main">
      <div class="container-fluid">
        <button class="btn-icon navbar-toggler me-2 bg-transparent border-0" type="button" data-bs-toggle="collapse"
          data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
          <i class="transportation-icon-menu fg-white"></i>
        </button>
        <a href="#" class="d-flex align-items-center">
          <span class="fs-lg fw-bold fg-white">Web App</span>
        </a>

        <ul class="navbar-nav d-flex align-items-center flex-row ms-auto">

          <li class="nav-item">
            <button class="btn-icon me-2 bg-transparent border-0" type="button"
              aria-label="Chat"
              data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="bottom" data-bs-title="Chat"
            >
              <i class="transportation-icon-chat fg-white"></i>
            </button>
          </li>

          <li class="nav-item">
            <span class="d-inline-flex" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="bottom" data-bs-title="Help">
              <button class="btn-icon me-2 bg-transparent border-0" type="button" aria-label="Help"
                data-bs-toggle="dialog" data-bs-target="#helpDialog">
                <i class="transportation-icon-help fg-white" aria-hidden="true"></i>
              </button>
            </span>
          </li>

          <li class="nav-item">
            <button class="btn-icon me-2 bg-transparent border-0" type="button" id="appMenuToggle" data-bs-toggle="menu"
              data-bs-placement="bottom"
              aria-controls="appMenu" aria-expanded="false" aria-label="My Apps">
              <i class="transportation-icon-apps fg-white" aria-hidden="true"></i>
            </button>
            <div class="menu p-0 text-body" id="appMenu" aria-labelledby="appMenuToggle" style="width: 320px;">
              <div class="align-items-center border-bottom d-flex justify-content-between px-3 py-2">
                <h2 class="h6 mb-0">My Apps</h2>
                <button class="btn-close" type="button" id="appMenuClose">
                  <span class="visually-hidden">Close My Apps</span>
                </button>
              </div>
              <div class="p-3 bg-1 bg-opacity-80">
                <div class="row g-3 text-center">
                  <div class="col-4">
                    <a class="card rounded-4 p-1 small text-decoration-none text-reset h-100" href="#">
                      <span class="app-menu-icon mx-auto">
                        <i class="modus-icon-path-duotone" aria-hidden="true"></i>
                      </span>
                      <span class="d-block mt-1 fg-body">Route Pro</span>
                    </a>
                  </div>
                  <div class="col-4">
                    <a class="card rounded-4 p-1 small text-decoration-none text-reset h-100" href="#">
                      <span class="app-menu-icon mx-auto">
                        <i class="modus-icon-briefcase-duotone" aria-hidden="true"></i>
                      </span>
                      <span class="d-block mt-1 fg-body">Smart Work</span>
                    </a>
                  </div>
                  <div class="col-4">
                    <a class="card rounded-4 p-1 small text-decoration-none text-reset h-100" href="#">
                      <span class="app-menu-icon mx-auto">
                        <i class="modus-icon-road-horizon-duotone" aria-hidden="true"></i>
                      </span>
                      <span class="d-block mt-1 fg-body">Road Plan</span>
                    </a>
                  </div>
                  <div class="col-4">
                    <a class="card rounded-4 p-1 small text-decoration-none text-reset h-100" href="#">
                      <span class="app-menu-icon mx-auto">
                        <i class="modus-icon-truck-duotone" aria-hidden="true"></i>
                      </span>
                      <span class="d-block mt-1 fg-body">Fleet Sync</span>
                    </a>
                  </div>
                  <div class="col-4">
                    <a class="card rounded-4 p-1 small text-decoration-none text-reset h-100" href="#">
                      <span class="app-menu-icon mx-auto">
                        <i class="modus-icon-package-duotone" aria-hidden="true"></i>
                      </span>
                      <span class="d-block mt-1 fg-body">Load Tracker</span>
                    </a>
                  </div>
                  <div class="col-4">
                    <span class="card rounded-4 p-1 opacity-50 pointer-events-none small text-secondary user-select-none">
                      <span class="app-menu-icon mx-auto position-relative">
                        <i class="modus-icon-chart-bar-duotone" aria-hidden="true"></i>
                        <span
                          class="align-items-center app-menu-lock bg-white bottom-0 d-flex end-0 justify-content-center position-absolute rounded-circle shadow-sm text-secondary">
                          <i class="modus-icon-lock-duotone" aria-hidden="true"></i>
                        </span>
                      </span>
                      <span class="d-block mt-1 fg-body">Insight Hub</span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="border-top py-3 text-center">
                <a class="app-menu-more align-items-center d-inline-flex gap-1 fg-body small text-decoration-none" href="#">
                  Browse All Apps
                  <i class="modus-icon-caret-right-duotone" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </li>

          <li class="nav-item">
            <button type="button" class="btn-icon btn-solid bg-transparent border-0" id="userMenuToggle" data-bs-toggle="menu"
              data-bs-placement="bottom-end"
              aria-expanded="false" aria-label="Christian Oliff, christian@example.com">
              <span class="avatar avatar-sm">
                <img class="avatar-img" src="https://github.com/coliff.png" width="40" height="40" alt="" aria-hidden="true">
              </span>
            </button>
            <div class="menu" style="--bs-menu-min-width: 14rem;">
              <span class="avatar-xl mx-auto">
                <img class="img-fluid rounded-circle m-3" src="https://github.com/coliff.png" width="128" height="128"
                  alt="coliff">
              </span>
              <div class="text-center fw-bold fs-5">Christian Oliff</div>
              <div class="text-center">christian@example.com</div>
              <div class="text-center opacity-75">(Company Administrator)</div>
              <div class="menu-divider"></div>
              <a class="menu-item" href="#">Sign Out</a>
            </div>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <main class="bottom-0 end-0 position-fixed start-0 top-0">
    <div id="map" class="h-100 w-100" role="region" aria-label="Map"></div>

    <div class="mt-5">
      <button class="app-map-action btn-solid theme-primary m-3 mt-5 position-absolute top-0 z-3" type="button"
        data-bs-toggle="drawer" data-bs-target="#drawerScrolling" aria-controls="drawerScrolling">Dispatch Trips</button>
    </div>


    <dialog class="drawer drawer-end" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="drawerScrolling"
      aria-labelledby="drawerScrollingLabel">
      <div class="drawer-header">
        <h5 class="drawer-title" id="drawerScrollingLabel">Dispatch Trips</h5> <button type="button" class="btn-close"
          data-bs-dismiss="drawer">
          <span class="visually-hidden">Close</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
            <path
              d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59 7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12 5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4Z"
              fill="currentColor"></path>
          </svg></button>
      </div>
      <div class="drawer-body">
        <div class="card">
          <h5 class="card-header">Featured</h5>
          <div class="card-body">
            <h4 class="card-title">Special title treatment</h4>
            <p class="card-text">With supporting text below as a natural lead-in to additional content.</p> <a href="#"
              class="btn-sm btn-solid theme-primary">Go somewhere</a>
          </div>
        </div>
      </div>
    </dialog>
  </main>

  <footer class="app-footer fixed-bottom bg-1 bg-opacity-80">
    <div class="container-fluid d-flex flex-row justify-content-between align-items-center py-1">

      <a href="#" class="small fg-body text-decoration-none"> &copy; 2026 Modus Bootstrap</a>
      <ul class="d-flex flex-row list-unstyled align-items-center mb-0">
        <li><a href="#" class="btn-sm btn-text small">Privacy Policy</a></li>
        <li><a href="#" class="btn-sm btn-text small">Terms of Use</a></li>
      </ul>
    </div>
  </footer>

  <dialog class="dialog dialog-lg" id="helpDialog">
    <div class="dialog-header">
      <h1 class="dialog-title">Help</h1> <button type="button" class="btn-close" data-bs-dismiss="dialog">
        <span class="visually-hidden">Close</span>
      </button>
    </div>
    <div class="dialog-body">
        <table class="table">
              <thead>
                <tr>
                  <th>Shortcut</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="w-25"><kbd>Shift</kbd> + <kbd>Ctrl</kbd> + <kbd>N</kbd></td>
                  <td>Creates a blank new route</td>
                </tr>
                <tr>
                  <td><kbd>Shift</kbd> + <kbd>Ctrl</kbd> + <kbd>S</kbd></td>
                  <td>Opens the save route dialog on the active route</td>
                </tr>
                <tr>
                  <td><kbd>Alt</kbd> + <kbd>F3</kbd></td>
                  <td>Invoke the Route Options dialog for the active route</td>
                </tr>
                <tr>
                  <td><kbd>F8</kbd></td>
                  <td>Deletes the active route card</td>
                </tr>
                <tr>
                  <td><kbd>Alt</kbd> + <kbd>F8</kbd></td>
                  <td>Deletes all of the route cards.</td>
                </tr>
                <tr>
                  <td><kbd>F10</kbd></td>
                  <td>Run the route (if auto-calculate is off)</td>
                </tr>
                <tr>
                  <td><kbd>F5</kbd></td>
                  <td>Display the Detailed Route Report for the active route.</td>
                </tr>
                <tr>
                  <td><kbd>F6</kbd></td>
                  <td>Display the State/Country Distance Report for the active route.</td>
                </tr>
              </tbody>
            </table>
    </div>
    <div class="dialog-footer" hidden></div>
  </dialog>

  <script is:inline src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
